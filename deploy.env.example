# Copy to deploy.env (not in git) and fill in. Read by scripts/deploy.mjs: yarn deploy:web, yarn deploy:server, yarn deploy:packages.

VUEPORT_FTP_HOST=vueport.net
VUEPORT_FTP_USER=
VUEPORT_FTP_PASSWORD=
VUEPORT_FTP_SECURE=true
VUEPORT_FTP_INSECURE_TLS=false

VUEPORT_WEB_DIR=/play.vueport.net
VUEPORT_WEB_URL=https://play.vueport.net/
VUEPORT_WEB_CHECK_AUTH=testuser:testpass

VUEPORT_SERVER_PUBLIC_DIR=/api.vueport.net/public
VUEPORT_SERVER_URL=https://api.vueport.net/

VUEPORT_PACKAGES_DIR=/packages.vueport.net
VUEPORT_PACKAGES_URL=https://packages.vueport.net/
