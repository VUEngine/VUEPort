{
  "name": "vueport",
  "version": "1.0.0",
  "description": "A Virtual Boy emulator",
  "license": "MIT",
  "author": "KR155E <c.radke@posteo.de>",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "clean": "yarn workspaces run clean",
    "lint": "yarn workspaces run lint",
    "lint:fix": "yarn workspaces run lint:fix",
    "test": "yarn workspaces run test",
    "nls-extract": "theia nls-extract -o packages/core/i18n/nls.json -r packages/core -f 'src/**/*.{ts,tsx}' -m true -e vuengine",
    "nls-localize": "theia nls-localize CS DE ES FR HU IT JA PL PT-BR PT-PT RU ZH-CN -f packages/core/i18n/nls.json --free-api true -k $1"
  },
  "devDependencies": {
    "@theia/cli": "1.74.0",
    "@types/chroma-js": "^2.4.4",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/eslint-plugin-tslint": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "eslint": "^7.32.0",
    "eslint-plugin-deprecation": "1.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-unsanitized": "^3.2.0",
    "eslint-plugin-react": "^7.37.5",
    "rimraf": "^2.7.1",
    "tslint": "^5.20.1",
    "typescript": "5.9.3"
  }
}
